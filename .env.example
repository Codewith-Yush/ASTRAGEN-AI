# ==========================================
# Astragen AI - Environment Configuration
# ==========================================

# Database Configuration (PostgreSQL / Neon - SERVER ONLY)
DATABASE_URL=postgresql://user:password@ep-sample-pooler.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-sample.region.aws.neon.tech/neondb?sslmode=require

# Clerk Authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_sample_clerk_publishable_key
CLERK_SECRET_KEY=sk_test_sample_clerk_secret_key
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# Google Gemini API (SERVER ONLY)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.1-flash-lite

# Razorpay Subscriptions & Payments
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_sample_key_id
RAZORPAY_SECRET_KEY=your_razorpay_secret_key_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here
SUBSCRIPTION_PLAN_ID=plan_sample_plan_id

# Email Service (Nodemailer SMTP - SERVER ONLY)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your_email@example.com
EMAIL_PASSWORD=your_email_app_password
CONTACT_RECEIVER_EMAIL=support@example.com
